{
  "name": "cvat-duplicate-box-detector",
  "description": "Read CVAT annotations, count bounding boxes, and inspect duplicate boxes.",
  "productName": "CVAT Box Counter & Duplicate Inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:electron\"",
    "desktop:electron": "wait-on tcp:127.0.0.1:3000 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:3000 electron .",
    "desktop:build": "vite build --base=./ --outDir dist-desktop",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis portable --x64",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.399.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
